# App
APP_NAME=file-service
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8006
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/file_service_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# MinIO (dedicated file-service instance — root docker-compose.yml service
# `file-minio`; separate from the `milvus-minio` container Milvus owns)
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_TLS=false
BUCKET_FILES=graphgpt-files
BUCKET_QUARANTINE=graphgpt-files-quarantine
MINIO_KAFKA_NOTIFICATION_ARN=arn:minio:sqs::file-events:kafka
# Requires the notify_kafka target to be registered server-side first (mc admin config set) — see docs/HLD.md §12
MINIO_NOTIFICATIONS_ENABLED=false
MINIO_OBJECT_EVENTS_TOPIC=minio.object.events
QUARANTINE_OBJECT_EXPIRY_DAYS=1

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=file-service-consumers
KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
KAFKA_CONSUMER_MAX_RECORDS=50

# Upload / Presign policy
UPLOAD_PRESIGN_TTL_SECONDS=900
DOWNLOAD_PRESIGN_TTL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=104857600
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_STRICT_POLICY=true

# GET /files pagination
FILE_LIST_DEFAULT_PAGE_SIZE=20
FILE_LIST_MAX_PAGE_SIZE=100

# Feature flags
AV_SCAN_ENABLED=false

# ClamAV (only used when CLAMAV_ENABLED=true; see docker-compose.yml's clamav service)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30.0

# Background workers
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_ORPHAN_GRACE_SECONDS=600
RECONCILIATION_POLL_TIMEOUT_MS=1000
RECONCILIATION_MAX_RECORDS=200
RECONCILIATION_CONSUMER_GROUP_ID=file-service-consumers-reconciliation

# Health checks
HEALTH_CHECK_TIMEOUT_SECONDS=3.0

# Auth — verifies JWTs issued by auth-service. Must match auth-service's own
# .env JWT_SECRET_KEY/JWT_ALGORITHM exactly (see auth-service/app/security/jwt_manager.py)
JWT_SECRET_KEY=supersecretjwtkeyforauthservicelocaldvelopment12345
JWT_ALGORITHM=HS256

# Service-to-service credential(s) for /internal/** (sent as a Bearer token by
# retrieval-service as FILE_SERVICE_SERVICE_CREDENTIAL). Comma-separated to allow rotation. Empty rejects all calls.
INTERNAL_SERVICE_TOKENS=dev-internal-token-change-me
